}

f_m_ct {
  s_m_title
  :::
  "Ethanol"
  m_atom[3] {
    # First column is atom index #
    i_m_atomic_number
    r_m_x_coord
    r_m_y_coord
    r_m_z_coord
    i_m_formal_charge
    s_m_pdb_atom_name
    :::
    1    6    1.200000    0.000000    0.000000    0 " C1 "
    2    6    0.000000    0.800000    0.000000    0 " C2 "
    3    8   -1.200000    0.000000    0.000000    0 " O  "
    :::
  }
  m_bond[2] {
    # First column is bond index #
    i_m_from
    i_m_to
    i_m_order
    :::
    1    1    2    1
    2    2    3    1
    :::
  }
}

